# Canonical public origin used to build absolute social-preview URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-owned provider selectors. Mock providers are the safe defaults.
CARBON_PROVIDER=mock
ENERGY_PROVIDER=mock
PROJECT_PROVIDER=mock
ROADMAP_PROVIDER=mock

# Reserved for a future reviewed Revert Tech integration.
# Required only when ENERGY_PROVIDER=revert.
REVERT_API_URL=
REVERT_API_KEY=
# Application freshness policy used only after an official integration exists.
REVERT_STALE_AFTER_MINUTES=30
# Short server-side cache for validated readings after an official transport exists.
REVERT_CACHE_TTL_SECONDS=60

# Reviewed normalized source documents. Required only when the corresponding
# provider is selected: inventory, start-snapshot, or config.
CARBON_DATA_URL=
START_PUBLIC_SNAPSHOT_URL=
ROADMAP_DATA_URL=
